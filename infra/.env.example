# PostgreSQL 16
POSTGRES_USER=siga_admin
POSTGRES_PASSWORD=siga_secret_password_2026
POSTGRES_DB=siga_universitario
POSTGRES_PORT=5432

# PgBouncer (Connection Pooler)
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=50

# Redis 7
REDIS_PORT=6380
REDIS_PASSWORD=siga_redis_secret_2026

# MinIO (S3-Compatible Object Storage)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_2026
MINIO_DEFAULT_BUCKETS=siga-documents,siga-proofs,siga-pautas

# Mailpit (Servidor SMTP de Desenvolvimento para Recuperação de Senha)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

