NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Conexao direta com PostgreSQL (para o Prisma rodar migracoes)
DIRECT_URL=postgresql://siga_admin:siga_secret_password_2026@localhost:5432/siga_universitario?schema=public

# Conexao via PgBouncer (para a aplicacao em tempo de execucao)
DATABASE_URL=postgresql://siga_admin:siga_secret_password_2026@localhost:6432/siga_universitario?schema=public&pgbouncer=true

# Redis (BullMQ, scripts Lua atomicos, WebSockets e rate limit)
REDIS_URL=redis://:siga_redis_secret_2026@localhost:6380

# Autenticacao JWT & Sessoes
JWT_SECRET=siga_super_secret_jwt_key_universitario_2026_angola_auth
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS (origens permitidas separadas por virgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# MinIO / Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret_2026
S3_BUCKET_DOCUMENTS=siga-documents
S3_BUCKET_PROOFS=siga-proofs
S3_BUCKET_PAUTAS=siga-pautas

# Servidor SMTP de Desenvolvimento (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIGA Universitario <nao-responder@siga.ao>"
PORTAL_URL=http://localhost:3000
